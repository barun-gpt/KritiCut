{
  "name": "kriticut",
  "version": "2.1.0",
  "private": true,
  "description": "KritiCut — a full-featured, offline-first video editor for the browser and Android.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build-www.mjs",
    "test": "node tests/smoke.mjs",
    "android:add": "npm run build && cap add android && npm run assets",
    "android:sync": "npm run build && cap sync android && npm run assets",
    "android:open": "cap open android",
    "assets": "capacitor-assets generate --android --iconBackgroundColor \"#0f0f14\" --iconBackgroundColorDark \"#0f0f14\" --splashBackgroundColor \"#0f0f14\" --splashBackgroundColorDark \"#0f0f14\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
